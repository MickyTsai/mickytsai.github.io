#!/usr/bin/env bash

set -euo pipefail

if [[ $# -ne 3 ]]; then
  printf '無法發布 MyBlog：需要 TextBundle、分類與標籤三個參數。\n' >&2
  exit 1
fi

bundle_path="$1"
category="$2"
tags="$3"

# Shortcuts may preserve harmless whitespace around a list item. Remove only
# leading and trailing whitespace so paths containing spaces remain intact.
bundle_path="${bundle_path#"${bundle_path%%[![:space:]]*}"}"
bundle_path="${bundle_path%"${bundle_path##*[![:space:]]}"}"
category="${category#"${category%%[![:space:]]*}"}"
category="${category%"${category##*[![:space:]]}"}"

if [[ ! -d "$bundle_path" || "${bundle_path##*.}" != "textbundle" ]]; then
  printf '格式不正確：發布 MyBlog 只接受 Ulysses 匯出的 TextBundle。\n' >&2
  exit 1
fi

if [[ -z "$category" ]]; then
  printf '無法發布 MyBlog：文章分類不能留空。\n' >&2
  exit 1
fi

script_directory="$(cd "$(dirname "$0")" && pwd)"
repo_root="$(cd "$script_directory/.." && pwd)"

publish_output="$(ruby "$repo_root/tools/myblog" publish "$bundle_path" --category "$category" --tags "$tags")"
printf '%s\n' "$publish_output"

published_url="$(printf '%s\n' "$publish_output" | sed -n 's/^✓ 網址：//p')"
if [[ -n "$published_url" ]]; then
  printf '%s' "$published_url" | pbcopy
fi
